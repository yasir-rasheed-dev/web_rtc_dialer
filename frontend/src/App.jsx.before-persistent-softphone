let socketClientLoader;
function ensureSocketClient() {
  if (window.io) return Promise.resolve();
  if (socketClientLoader) return socketClientLoader;
  socketClientLoader = new Promise((resolve, reject) => {
    const script = document.createElement("script");
    script.src = "/socket.io/socket.io.js";
    script.async = true;
    script.onload = resolve;
    script.onerror = () => reject(new Error("Real-time client could not be loaded"));
    document.head.appendChild(script);
  });
  return socketClientLoader;
}

function hasAny(session, permissions) {
  const available = new Set(session?.permissions || []);
  return permissions.some((permission) => available.has(permission));
}

function formatSeconds(value = 0) {
  const seconds = Number(value) || 0;
  const hours = Math.floor(seconds / 3600);
  const minutes = Math.floor((seconds % 3600) / 60);
  const rest = seconds % 60;
  return hours ? `${hours}h ${minutes}m` : `${minutes}:${String(rest).padStart(2, "0")}`;
}

function formatDate(value) {
  if (!value) return "—";
  return new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" }).format(new Date(value));
}

function Login({ onAuthenticated }) {
  const [workspace, setWorkspace] = useState(localStorage.getItem("ringnex.workspace") || "legacy");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [error, setError] = useState("");
  const [busy, setBusy] = useState(false);

  const submit = async (event) => {
    event.preventDefault();
    setBusy(true); setError("");
    try {
      const payload = await api("/auth/login", { method: "POST", body: { workspace, email, password } });
      setToken(payload.token);
      localStorage.setItem("ringnex.workspace", workspace);
      onAuthenticated(payload);
    } catch (requestError) {
      setError(requestError.message);
    } finally {
      setBusy(false);
    }
  };

  return <main className="login-screen"><section className="login-card"><div className="login-brand"><span>RN</span><div><strong>Ringnex</strong><small>SaaS Contact Center</small></div></div><div className="login-copy"><span className="overline">WORKSPACE SIGN IN</span><h1>Welcome back</h1><p>Use the setup/workspace assigned by your Ringnex Product Owner.</p></div><form onSubmit={submit}><label>Workspace<input value={workspace} onChange={(e) => setWorkspace(e.target.value.toLowerCase())} placeholder="abc-towing" autoComplete="organization" required /></label><label>Email<input type="email" value={email} onChange={(e) => setEmail(e.target.value)} autoComplete="username" required /></label><label>Password<input type="password" value={password} onChange={(e) => setPassword(e.target.value)} autoComplete="current-password" required /></label>{error && <div className="form-error">{error}</div>}<button className="primary-action" disabled={busy}>{busy ? <RefreshCw className="spin" size={17} /> : <ShieldCheck size={17} />}{busy ? "Signing in…" : "Sign in"}</button></form><div className="login-security"><ShieldCheck size={18} /><span>Tenant-isolated session · WSS signaling · DTLS-SRTP media</span></div></section><aside className="login-visual"><div className="signal-orbit"><Radio /><i /><i /><i /></div><h2>One app.<br />Your own workspace.</h2><p>Roles, extensions, contacts, calls and DIDs are resolved after authentication.</p></aside></main>;
}

function KpiCard({ label, value, detail, icon: Icon, tone = "blue" }) {
  return <article className={`kpi-card ${tone}`}><span className="kpi-icon"><Icon size={19} /></span><div><small>{label}</small><strong>{value}</strong><p>{detail}</p></div></article>;
}

function Dashboard({ user, tenant, liveCalls, amiConnected }) {
  const [report, setReport] = useState(null);
  const [error, setError] = useState("");
  useEffect(() => { api("/reports/kpis?days=7").then(setReport).catch((e) => setError(e.message)); }, []);
  const summary = report?.summary || {};
  const maximum = Math.max(1, ...(report?.daily || []).map((row) => Number(row.calls)));
  return <div className="page-stack"><div className="page-heading"><div><span className="overline">{tenant?.name || "WORKSPACE"}</span><h1>Good day, {user.name.split(" ")[0]}</h1><p>{tenant?.workspace} · {user.roleName}</p></div><span className={`system-pill ${amiConnected ? "ok" : "bad"}`}><Signal size={15} />AMI {amiConnected ? "connected" : "offline"}</span></div>{error && <div className="alert error">{error}</div>}<div className="kpi-grid"><KpiCard label="Total calls" value={summary.total_calls || 0} detail="Last 7 days" icon={PhoneCall} /><KpiCard label="Completed" value={summary.completed_calls || 0} detail={`${summary.answer_rate || 0}% answer rate`} icon={ShieldCheck} tone="green" /><KpiCard label="Average talk" value={formatSeconds(summary.avg_talk_sec)} detail="Connected calls" icon={Clock3} tone="purple" /><KpiCard label="Live now" value={liveCalls.length} detail="Visible to your role" icon={Activity} tone="orange" /></div><div className="dashboard-grid"><section className="console-card chart-card"><div className="card-title"><div><h2>Call volume</h2><p>Daily activity for the last 7 days</p></div><BarChart3 size={20} /></div><div className="bar-chart">{(report?.daily || []).map((row) => <div className="bar-column" key={row.day}><span className="bar-value">{row.calls}</span><div style={{ height: `${Math.max(8, (Number(row.calls) / maximum) * 150)}px` }} /><small>{new Date(row.day).toLocaleDateString(undefined, { weekday: "short" })}</small></div>)}{!report?.daily?.length && <div className="empty-block">No call data yet</div>}</div></section><section className="console-card"><div className="card-title"><div><h2>Live activity</h2><p>Tenant-isolated Asterisk channels</p></div><span className="live-dot">LIVE</span></div><div className="activity-list">{liveCalls.slice(0, 6).map((call) => <div key={call.linkedid}><span className="avatar mini">{(call.agent || "?").slice(-2).toUpperCase()}</span><div><strong>{call.agent || "Unassigned"}</strong><small>{call.from} → {call.to}</small></div><span className="status-tag active">{call.status}</span></div>)}{!liveCalls.length && <div className="empty-block">No active calls</div>}</div></section></div></div>;
}

function CallsPage() {
  const [result, setResult] = useState({ rows: [], total: 0, page: 1, pageSize: 25 });
  const [search, setSearch] = useState("");
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [audio, setAudio] = useState(null);
  const load = useCallback(async (page = 1) => { setLoading(true); setError(""); try { setResult(await api(`/calls?page=${page}&pageSize=25&search=${encodeURIComponent(search)}`)); } catch (e) { setError(e.message); } finally { setLoading(false); } }, [search]);
  useEffect(() => { load(1); }, [load]);
  useEffect(() => () => { if (audio?.url) URL.revokeObjectURL(audio.url); }, [audio]);
  const play = async (call) => { setError(""); try { if (audio?.url) URL.revokeObjectURL(audio.url); setAudio({ call, url: await recordingBlob(call.id) }); } catch (e) { setError(e.message); } };
  return <div className="page-stack"><div className="page-heading"><div><span className="overline">CONVERSATION HISTORY</span><h1>Calls & recordings</h1><p>Only call records allowed by your role and workspace are returned.</p></div><button className="secondary-action" onClick={() => load(result.page)}><RefreshCw size={16} />Refresh</button></div><section className="console-card table-card"><div className="table-tools"><form onSubmit={(e) => { e.preventDefault(); load(1); }} className="search-box"><Search size={17} /><input value={search} onChange={(e) => setSearch(e.target.value)} placeholder="Number or agent…" /></form><span>{result.total} records</span></div>{error && <div className="alert error">{error}</div>}<div className="data-table-wrap"><table><thead><tr><th>Started</th><th>Agent</th><th>Direction</th><th>From</th><th>To</th><th>Status</th><th>Talk time</th><th>Recording</th></tr></thead><tbody>{result.rows.map((call) => <tr key={call.id}><td>{formatDate(call.started_at)}</td><td>{call.agent_sip_username || "—"}</td><td><span className="direction-tag">{call.direction}</span></td><td>{call.from_number}</td><td>{call.to_number}</td><td><span className={`status-tag ${call.status === "COMPLETED" ? "active" : "neutral"}`}>{call.status}</span></td><td>{formatSeconds(call.billable_sec)}</td><td>{call.recording_name ? <button className="text-button" onClick={() => play(call)}><FileAudio size={15} />Play</button> : "—"}</td></tr>)}</tbody></table>{loading && <div className="table-loading">Loading call records…</div>}{!loading && !result.rows.length && <div className="empty-block">No matching calls</div>}</div><div className="pagination"><button disabled={result.page <= 1} onClick={() => load(result.page - 1)}>Previous</button><span>Page {result.page} of {Math.max(1, Math.ceil(result.total / result.pageSize))}</span><button disabled={result.page * result.pageSize >= result.total} onClick={() => load(result.page + 1)}>Next</button></div></section>{audio && <div className="audio-drawer"><div><FileAudio /><span><strong>{audio.call.from_number} → {audio.call.to_number}</strong><small>{formatDate(audio.call.started_at)}</small></span></div><audio src={audio.url} controls autoPlay /><button onClick={() => setAudio(null)} aria-label="Close"><X /></button></div>}</div>;
}

function Supervisor({ liveCalls, presence, amiConnected, permissions }) {
  const [message, setMessage] = useState("");
  const can = (key) => permissions.includes(key);
  const monitor = async (linkedid, mode) => { setMessage(""); try { await api("/supervisor/monitor", { method: "POST", body: { linkedid, mode } }); setMessage(`${mode} request sent to your SIP phone.`); } catch (e) { setMessage(e.message); } };
  return <div className="page-stack"><div className="page-heading"><div><span className="overline">REAL-TIME FLOOR</span><h1>Supervisor dashboard</h1><p>Only agents and calls inside this tenant are eligible for monitoring.</p></div><span className={`system-pill ${amiConnected ? "ok" : "bad"}`}><Radio size={15} />{amiConnected ? "Live" : "AMI offline"}</span></div>{message && <div className="alert">{message}</div>}<div className="kpi-grid compact"><KpiCard label="Agents online" value={presence.filter((p) => p.status === "ONLINE").length} detail={`${presence.length} tracked`} icon={Users} tone="green" /><KpiCard label="Live calls" value={liveCalls.length} detail="Right now" icon={PhoneCall} /><KpiCard label="Ringing" value={liveCalls.filter((c) => c.status === "RINGING").length} detail="Awaiting answer" icon={Clock3} tone="orange" /></div><section className="console-card table-card"><div className="card-title"><div><h2>Active calls</h2><p>Buttons are shown only when the assigned role permits that monitoring mode.</p></div></div><div className="data-table-wrap"><table><thead><tr><th>Agent</th><th>From</th><th>To</th><th>Status</th><th>Started</th><th>Supervisor action</th></tr></thead><tbody>{liveCalls.map((call) => <tr key={call.linkedid}><td>{call.agent || "—"}</td><td>{call.from}</td><td>{call.to}</td><td><span className="status-tag active">{call.status}</span></td><td>{formatDate(call.startedAt)}</td><td><div className="inline-actions">{can("LISTEN_LIVE_CALLS") && <button onClick={() => monitor(call.linkedid, "listen")}>Listen</button>}{can("WHISPER_CALLS") && <button onClick={() => monitor(call.linkedid, "whisper")}>Whisper</button>}{can("BARGE_CALLS") && <button className="danger" onClick={() => monitor(call.linkedid, "barge")}>Barge</button>}</div></td></tr>)}</tbody></table>{!liveCalls.length && <div className="empty-block">No live calls to monitor</div>}</div></section></div>;
}

function Reports() {
  const [days, setDays] = useState(30);
  const [report, setReport] = useState(null);
  const [error, setError] = useState("");
  useEffect(() => { api(`/reports/kpis?days=${days}`).then(setReport).catch((e) => setError(e.message)); }, [days]);
  const summary = report?.summary || {};
  return <div className="page-stack"><div className="page-heading"><div><span className="overline">PERFORMANCE INTELLIGENCE</span><h1>Reports & KPIs</h1><p>Tenant-scoped operational metrics calculated from Asterisk call events.</p></div><select className="select-control" value={days} onChange={(e) => setDays(e.target.value)}><option value="7">Last 7 days</option><option value="30">Last 30 days</option><option value="90">Last 90 days</option></select></div>{error && <div className="alert error">{error}</div>}<div className="kpi-grid"><KpiCard label="Answer rate" value={`${summary.answer_rate || 0}%`} detail={`${summary.completed_calls || 0} completed`} icon={ShieldCheck} tone="green" /><KpiCard label="Talk time" value={formatSeconds(summary.total_talk_sec)} detail="Total connected" icon={Clock3} /><KpiCard label="Failed" value={summary.failed_calls || 0} detail="Review routing/CDR" icon={Activity} tone="orange" /></div><section className="console-card table-card"><div className="card-title"><div><h2>Agent performance</h2><p>Volume and handling time by agent</p></div></div><div className="data-table-wrap"><table><thead><tr><th>Agent</th><th>Calls</th><th>Completed</th><th>Answer rate</th><th>Total talk</th><th>Average talk</th></tr></thead><tbody>{(report?.agents || []).map((row) => <tr key={row.agent}><td><strong>{row.agent}</strong></td><td>{row.calls}</td><td>{row.completed}</td><td>{row.calls ? Math.round((row.completed / row.calls) * 100) : 0}%</td><td>{formatSeconds(row.talk_sec)}</td><td>{formatSeconds(row.avg_talk_sec)}</td></tr>)}</tbody></table>{!report?.agents?.length && <div className="empty-block">No performance data yet</div>}</div></section></div>;
}

function TenantApp() {
  const [session, setSession] = useState(null);
  const [loading, setLoading] = useState(Boolean(getToken()));
  const [page, setPage] = useState("dashboard");
  const [sidebarOpen, setSidebarOpen] = useState(false);
  const [liveCalls, setLiveCalls] = useState([]);
  const [presence, setPresence] = useState([]);
  const [amiConnected, setAmiConnected] = useState(false);
  const [agentStatus, setAgentStatus] = useState("OFFLINE");

  useEffect(() => {
    if (!getToken()) { setLoading(false); return; }
    api("/auth/session").then(setSession).catch(() => setToken("")).finally(() => setLoading(false));
  }, []);

  useEffect(() => {
    if (!session) return undefined;
    let cancelled = false;
    let socket;
    ensureSocketClient().then(() => {
      if (cancelled) return;
      socket = window.io({ path: "/socket.io", auth: { token: getToken() } });
      socket.on("system:state", (state) => { setAmiConnected(Boolean(state.ami)); setLiveCalls(state.calls || []); });
      socket.on("ami:status", (state) => setAmiConnected(Boolean(state.connected)));
      socket.on("call:update", (call) => setLiveCalls((calls) => [...calls.filter((item) => item.linkedid !== call.linkedid), call]));
      socket.on("call:ended", (call) => setLiveCalls((calls) => calls.filter((item) => item.linkedid !== call.linkedid)));
      socket.on("presence:update", (item) => setPresence((items) => [...items.filter((entry) => entry.agent !== item.agent), item]));
    }).catch(() => setAmiConnected(false));
    return () => { cancelled = true; socket?.disconnect(); };
  }, [session]);

  useEffect(() => {
    if (!session || !hasAny(session, ["MONITOR_CALLS", "VIEW_REPORTS"])) return;
    api("/supervisor/live").then((state) => { setLiveCalls(state.calls || []); setPresence(state.presence || []); setAmiConnected(Boolean(state.ami)); }).catch(() => undefined);
  }, [session]);

  const navigation = useMemo(() => NAVIGATION.filter((item) => hasAny(session, item.permissions)), [session]);
  useEffect(() => {
    if (navigation.length && !navigation.some((item) => item.id === page)) setPage(navigation[0].id);
  }, [navigation, page]);

  const changeStatus = async (status) => { setAgentStatus(status); await api("/agent/status", { method: "POST", body: { status } }).catch(() => undefined); };
  const logout = async () => { await api("/auth/logout", { method: "POST" }).catch(() => undefined); setToken(""); setSession(null); };

  if (loading) return <div className="splash"><RefreshCw className="spin" /><span>Loading Ringnex…</span></div>;
  if (!session) return <Login onAuthenticated={setSession} />;

  const renderPage = () => {
    if (page === "dialer") return <div className="embedded-softphone"><Softphone sip={session.sip} permissions={session.permissions || []} /></div>;
    if (page === "contacts") return <ContactsPage />;
    if (page === "calls") return <CallsPage />;
    if (page === "supervisor") return <Supervisor liveCalls={liveCalls} presence={presence} amiConnected={amiConnected} permissions={session.permissions || []} />;
    if (page === "reports") return <Reports />;
    if (page === "users") return <UsersAdmin />;
    if (page === "roles") return <RolesAdmin />;
    if (page === "dids") return <DidsPage />;
    if (page === "usage") return <UsagePage />;
    return <Dashboard user={session.user} tenant={session.tenant} liveCalls={liveCalls} amiConnected={amiConnected} />;
  };

  const activeNav = NAVIGATION.find((item) => item.id === page);
  return <div className="console-shell"><aside className={`console-sidebar ${sidebarOpen ? "open" : ""}`}><div className="console-brand"><span>RN</span><div><strong>{session.tenant?.name || "Ringnex"}</strong><small>{session.tenant?.workspace || "Contact Center"}</small></div><button onClick={() => setSidebarOpen(false)}><X /></button></div><nav>{navigation.map(({ id, label, icon: Icon }) => <button key={id} className={page === id ? "active" : ""} onClick={() => { setPage(id); setSidebarOpen(false); }}><Icon size={18} /><span>{label}</span><ChevronRight size={14} /></button>)}</nav><div className="sidebar-system"><span className={`presence-dot ${amiConnected ? "online" : ""}`} /><div><strong>Asterisk AMI</strong><small>{amiConnected ? "Connected" : "Offline"}</small></div></div></aside><div className="console-content"><header className="console-header"><button className="menu-button" onClick={() => setSidebarOpen(true)}><Menu /></button><div className="header-context"><span>{activeNav?.label}</span></div><div className="header-actions">{hasAny(session, ["VIEW_DIALER"]) && session.sip && <select className={`agent-state ${agentStatus.toLowerCase()}`} value={agentStatus} onChange={(e) => changeStatus(e.target.value)}><option>OFFLINE</option><option>READY</option><option>PAUSED</option><option>WRAP_UP</option></select>}<div className="user-menu"><span className="avatar"><CircleUserRound /></span><div><strong>{session.user.name}</strong><small>{session.role?.name || session.user.roleName}</small></div></div><button className="logout-button" onClick={logout} title="Sign out"><LogOut size={18} /></button></div></header><main className="console-main">{renderPage()}</main></div></div>;
}

export default function App() {
  if (window.location.pathname === "/admin" || window.location.pathname.startsWith("/admin/")) {
    return <SuperAdminApp />;
  }
  return <TenantApp />;
}
