# Template for frontend/.env.electron (gitignored, same as .env).
# Used only by `npm run build:electron` — see frontend/src/lib/apiConfig.js
# and electron/README.md for the full picture.

# Your hosted backend's public origin. Required — the desktop app is loaded
# from a different origin ("app://myaiobyoc"), so /api and /socket.io calls
# need an absolute URL. Must also be allowed by the backend's
# FRONTEND_ORIGIN/EXTRA_FRONTEND_ORIGINS (backend/.env) CORS allow-list.
VITE_API_BASE_URL=https://asterisk.ringnex.co

# Same values as your frontend/.env — copy them here too.
VITE_SIP_DOMAIN=asterisk.ringnex.co
VITE_WSS_URL=wss://asterisk.ringnex.co/webrtc-ws
VITE_DEFAULT_SIP_USER=webdialer01

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
