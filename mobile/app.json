{
  "expo": {
    "name": "ringNex",
    "slug": "ringnex-mobile",
    "version": "1.0.0",
    "scheme": "ringnex",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0684BC",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.ringnex.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ringNex needs the microphone for calls.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false
    },
    "android": {
      "package": "co.ringnex.mobile",
      "versionCode": 1,
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "BLUETOOTH"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-asset",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": false,
          "microphonePermission": "ringNex needs the microphone for calls."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBase": "https://demoapi.ringnex.co",
      "sipDomain": "asterisk.ringnex.co",
      "wssUrl": "wss://asterisk.ringnex.co/webrtc-ws",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b7598267-cf41-432f-9b77-08a39412eff6"
      }
    },
    "owner": "yasirdeveloper",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b7598267-cf41-432f-9b77-08a39412eff6"
    }
  }
}
