NODE_ENV=production
PORT=3100
TRUST_PROXY=1
FRONTEND_ORIGIN=https://asterisk.ringnex.co

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ringnex_dialer
DB_USER=ringnex_app
DB_PASSWORD=CHANGE_ME

# Generate with: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_EXPIRES_IN=8h

# Generate with: openssl rand -base64 32
SIP_CREDENTIAL_KEY=CHANGE_ME_TO_BASE64_32_BYTE_KEY
PUBLIC_WSS_URL=wss://asterisk.ringnex.co/ws
PUBLIC_SIP_DOMAIN=asterisk.ringnex.co

AMI_HOST=127.0.0.1
AMI_PORT=5040
AMI_USERNAME=ringnex-app
AMI_SECRET=CHANGE_ME

RECORDING_ROOT=/opt/ringnex-webrtc/var/spool/asterisk/monitor
RECORDING_RETENTION_DAYS=90

# Separate spool for agent-busy-decline voicemails — its own SSHFS mount,
# kept apart from RECORDING_ROOT above.
VOICEMAIL_ROOT=/opt/ringnex-webrtc/var/spool/asterisk/voicemail-custom

# Only used by npm run seed:admin
ADMIN_EMAIL=admin@ringnex.co
ADMIN_PASSWORD=CHANGE_ME_NOW
ADMIN_NAME=Ringnex Administrator

# SaaS Product Owner / Super Admin. Used by: npm run seed:super-admin
SUPER_ADMIN_EMAIL=owner@ringnex.co
SUPER_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD
SUPER_ADMIN_NAME=Ringnex Product Owner

# Commio CDR integration is intentionally not hard-coded until the exact account/API contract is supplied.
# Add the provider endpoint/token here when wiring the CDR adapter.
COMMIO_CDR_API_URL=
COMMIO_CDR_API_USERNAME=
COMMIO_CDR_API_TOKEN=
COMMIO_ACCOUNT_ID=

# Fixed physical Asterisk trunk endpoint — the same for every tenant on this
# box. Each tenant gets its OWN Commio routing profile (created/assigned via
# Super Admin, stored in tenants.commio_routing_profile_id), but every one of
# those profiles points at this same trunk. Defaults match the current trunk
# if left blank (see config.js).
COMMIO_TRUNK_HOST=
COMMIO_TRUNK_PORT=

# Optional: use a temporary DDL-capable account only for npm run migrate:saas.
# If omitted, the normal DB_USER/DB_PASSWORD are used.
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=

# Firebase Admin SDK — used server-side for sending FCM push notifications
# for Team Chat. From Firebase Console > Project Settings > Service Accounts
# > Generate new private key. Paste the private_key value as-is (with
# literal \n sequences) — it's un-escaped at load time in config.js.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
