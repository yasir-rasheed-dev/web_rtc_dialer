NODE_ENV=production
PORT=3100
TRUST_PROXY=1
FRONTEND_ORIGIN=https://asterisk.ringnex.co

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ringnex_dialer
DB_USER=ringnex_app
DB_PASSWORD=CHANGE_ME

# Generate with: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_EXPIRES_IN=8h

# Generate with: openssl rand -base64 32
SIP_CREDENTIAL_KEY=CHANGE_ME_TO_BASE64_32_BYTE_KEY
PUBLIC_WSS_URL=wss://asterisk.ringnex.co/ws
PUBLIC_SIP_DOMAIN=asterisk.ringnex.co

AMI_HOST=127.0.0.1
AMI_PORT=5040
AMI_USERNAME=ringnex-app
AMI_SECRET=CHANGE_ME

RECORDING_ROOT=/opt/ringnex-webrtc/var/spool/asterisk/monitor
RECORDING_RETENTION_DAYS=90

# Only used by npm run seed:admin
ADMIN_EMAIL=admin@ringnex.co
ADMIN_PASSWORD=CHANGE_ME_NOW
ADMIN_NAME=Ringnex Administrator

# SaaS Product Owner / Super Admin. Used by: npm run seed:super-admin
SUPER_ADMIN_EMAIL=owner@ringnex.co
SUPER_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD
SUPER_ADMIN_NAME=Ringnex Product Owner

# Commio CDR integration is intentionally not hard-coded until the exact account/API contract is supplied.
# Add the provider endpoint/token here when wiring the CDR adapter.
COMMIO_CDR_API_URL=
COMMIO_CDR_API_TOKEN=

# Optional: use a temporary DDL-capable account only for npm run migrate:saas.
# If omitted, the normal DB_USER/DB_PASSWORD are used.
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=
